    "bundle:report": "node scripts/bundle-report.mjs",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
